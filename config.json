{
  "FONT": "Times New Roman",
  "FONT_SIZE_PT": 12,
  "LINE_SPACING": "single",
  "MARGIN_CM": 2.5,
  "LINE_NUMBERS": true,
  "JUSTIFY": true,
  "FIGURE_WIDTH_CM": 16,
  "FLOAT_PLACEMENT": "end",
  "FIGURE_EXPORT_FORMAT": "tiff",
  "FIGURE_MIN_DPI": 300,
  "CITATION_STYLE": "author-year",
  "REF_MAX_AUTHORS": 6,
  "OUTPUT_DOCX": "manuscript.docx",
  "SEARCH_FROM_YEAR": 2005,
  "MIN_REFERENCES": 30,
  "MAX_REFERENCES": 40,
  "MIN_WORDS": 5500,
  "MAX_WORDS": 12000,
  "PERSON": "passive",
  "MAX_SENTENCE_WORDS": 45,
  "MIN_SENTENCE_LENGTH_CV": 0.35,
  "MAX_TRANSITION_OPENER_RATIO": 0.05,
  "NOTE_REQUIRED_HEADINGS": [
    "## Bibliographic record",
    "## Section-by-section reading log",
    "## Quality appraisal",
    "## Relevance to this manuscript",
    "## Decision",
    "## Claims"
  ],
  "NUMBER_WHITELIST": [
    "\\bAPOE\\s*(ε|e)\\s*\\d\\b",
    "\\bε\\d\\b",
    "\\brs\\d+\\b",
    "\\b1000 Genomes\\b",
    "\\bchromosomes?\\s+\\d+(\\s*(and|,)\\s*\\d+)*\\b",
    "\\bchr\\d+(:\\S+)?",
    "\\bGRCh3[78]\\b",
    "\\bhg(19|38)\\b",
    "\\b[A-Z][A-Z0-9\\-]*\\d[A-Z0-9\\-]*\\b",
    "\\btype 2\\b",
    "\\bPhase 3\\b",
    "\\bH4\\b"
  ],
  "METHOD_TERMS_REQUIRING_CITATION": [
    "LDSC",
    "LD score regression",
    "GenomicSEM",
    "Genomic SEM",
    "LAVA",
    "MAGMA",
    "TwoSampleMR",
    "MR-Egger",
    "weighted median",
    "weighted mode",
    "inverse-variance weighted",
    "MR-PRESSO",
    "Steiger",
    "MRlap",
    "coloc",
    "PLINK",
    "1000 Genomes",
    "Benjamini",
    "STROBE-MR",
    "GWAS Catalog",
    "Psychiatric Genomics Consortium",
    "PGC",
    "UK Biobank",
    "FinnGen",
    "IGAP",
    "European Alzheimer",
    "EADB",
    "NIAGADS"
  ],
  "EXTRA_BANNED_PATTERNS": [
    "\\bpre-?regist(ered|ration)\\b",
    "\\bregistered (analysis )?plan\\b"
  ],
  "SECTION_RULES": {
    "01_abstract.md": "abstract",
    "02_introduction.md": "cite_every_sentence",
    "03_methods.md": "methods",
    "04_results.md": "results",
    "05_discussion.md": "cite_or_result",
    "06_conclusion.md": "cite_or_result",
    "07_statements.md": "lint_only"
  },
  "VERBATIM_REQUIRED": {
    "We want to acknowledge the participants and investigators of the FinnGen study.": "FinnGen results access terms, https://www.finngen.fi/en/access_results (archived docs/evidence/providers/www_finngen_fi_en_access_results.html, 2026-11-22)"
  }
}
